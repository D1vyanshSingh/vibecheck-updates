[TEMPLATE]
# Copy to .env.local for the frontend and export the backend values in the
# worker/host environment. Never commit real values.

# ---------------------------------------------------------------- Supabase
# Public: needed by the browser for auth. Protected by RLS, not by secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: early-access insert and backend privileged writes.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for local HS256 tests. Leave empty in production (RS256 via JWKS).
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------ Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------ OmniRoute
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_DEFAULT_MODEL=

# -------------------------------------------------------------- GitHub App
# Read-only installation. Never request write access just to scan code.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_STATE_SECRET=

# ------------------------------------------------------------ Scan limits
SOURCE_STORAGE_DIR=./backend/sources
SCANNER_BIN=./backend/.tools
SCANNER_TIMEOUT_SECONDS=300
JOB_TIMEOUT_SECONDS=600
MAX_ATTEMPTS=3
MAX_ZIP_BYTES=52428800
MAX_EXTRACTED_BYTES=262144000
MAX_FILE_COUNT=20000
# Default off. Only enable to assess a target you control on a private network
# (for example a local test server). Cloud metadata and link-local stay blocked.
ASSESSMENT_ALLOW_PRIVATE_HOSTS=false

# ------------------------------------------------------------- URL scanner
# Local Python scanner (vulnscan) used by /scan. Relative paths resolve from
# this app's directory.
VULNSCAN_DIR=./scanner-service
SCANNER_PYTHON=python3
# Default off, so any hostname that resolves can be scanned — including LAN and
# loopback targets, which is what people usually want from their own machine.
# Set to 1 on a shared/public deployment to refuse private and loopback ranges.
# Cloud metadata and link-local addresses stay blocked either way.
SCAN_BLOCK_PRIVATE_TARGETS=

# Where the deployed site runs scans. Unset = spawn the bundled Python
# scanner (local development, or any Node host with Python installed).
# Set = POST to the scanner service in scanner-service/, which is what a
# Vercel deployment needs because functions have no Python process.
SCANNER_URL=
# Shared secret between the site and the scan service. Generate one with:
#   openssl rand -hex 32
SCAN_SECRET=

# ------------------------------------------------------------------ Worker
WORKER_ID=worker-local
WORKER_POLL_SECONDS=3
